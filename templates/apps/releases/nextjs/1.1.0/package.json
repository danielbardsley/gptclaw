{
  "name": "gptclaw-nextjs-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/health.test.ts",
    "format": "prettier --write app tests eslint.config.mjs tsconfig.json package.json",
    "lint": "prettier --check app tests eslint.config.mjs tsconfig.json package.json && eslint app tests",
    "security": "pnpm audit --audit-level=high",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2"
  }
}
