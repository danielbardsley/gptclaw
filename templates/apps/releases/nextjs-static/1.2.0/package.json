{
  "name": "gptclaw-static-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "format": "prettier --check app lib scripts tests next.config.ts eslint.config.js tsconfig.json package.json",
    "lint": "eslint app lib scripts tests next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "links": "node scripts/check-output.mjs",
    "browser": "node scripts/browser.mjs",
    "security": "pnpm audit --audit-level=high",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm links && pnpm security"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "playwright-core": "1.64.0",
    "axe-core": "4.11.1",
    "parse5": "8.0.0"
  },
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.10.1"
  }
}
