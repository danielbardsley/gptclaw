FROM docker.io/library/node@sha256:51b1100cc2a83d370c6a60952e3f2989c8a43159d0e38586e090f3b3326efefd
WORKDIR /opt/eas
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund && npm cache clean --force && test "$(node --version)" = v24.21.0
COPY worker.cjs ./worker.cjs
ENV EXPO_NO_TELEMETRY=1 EXPO_NO_DOTENV=1 EAS_NO_VCS=1 EAS_SKIP_AUTO_FINGERPRINT=1
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/eas/worker.cjs"]
