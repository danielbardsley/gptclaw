{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gptclaw:project:v10",
  "title": "GptClaw static web project, version 10",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 10
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "kind": {
          "type": "string",
          "const": "web"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "build": {
          "const": [
            "pnpm",
            "build"
          ],
          "type": "array"
        },
        "start": {
          "const": [
            "pnpm",
            "start"
          ],
          "type": "array"
        },
        "test": {
          "const": [
            "pnpm",
            "test"
          ],
          "type": "array"
        },
        "format": {
          "const": [
            "pnpm",
            "format"
          ],
          "type": "array"
        },
        "lint": {
          "const": [
            "pnpm",
            "lint"
          ],
          "type": "array"
        },
        "typecheck": {
          "const": [
            "pnpm",
            "typecheck"
          ],
          "type": "array"
        },
        "security": {
          "const": [
            "pnpm",
            "security"
          ],
          "type": "array"
        },
        "verify": {
          "const": [
            "pnpm",
            "verify"
          ],
          "type": "array"
        }
      },
      "required": [
        "build",
        "start",
        "test",
        "format",
        "lint",
        "typecheck",
        "security",
        "verify"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "internal_port": {
          "const": 3000,
          "type": "integer"
        },
        "health": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]*(?![\\s\\S])"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "required": [
            "path",
            "timeout_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "internal_port",
        "health"
      ],
      "additionalProperties": false
    },
    "exposure": {
      "type": "object",
      "properties": {
        "private": {
          "type": "boolean",
          "const": true
        },
        "base_path": {
          "type": "string",
          "pattern": "^/projects/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/(?![\\s\\S])",
          "maxLength": 59
        },
        "funnel": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "private",
        "base_path",
        "funnel"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "ephemeral"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "commands",
    "service",
    "exposure",
    "data"
  ],
  "additionalProperties": false
}
