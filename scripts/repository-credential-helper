#!/usr/bin/env bash
set -euo pipefail
helper_entry=$(readlink -f -- "${BASH_SOURCE[0]}")
helper_root=$(cd -- "$(dirname -- "$helper_entry")/.." && pwd)
helper_python="$helper_root/.venv-manifest/bin/python"
if [[ -f "$helper_root/.python-path" ]]; then
  IFS= read -r helper_python < "$helper_root/.python-path"
fi
[[ -x "$helper_python" ]] || exit 1
exec "$helper_python" "$helper_root/scripts/repository_credential_helper.py" "$@"
