{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gptclaw:project:v12",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 12
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "kind": {
          "const": "mobile"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "mobile": {
      "type": "object",
      "properties": {
        "adapter": {
          "const": "expo-dev-v1"
        },
        "targets": {
          "const": [
            "android"
          ]
        },
        "app_config": {
          "const": "app.json"
        }
      },
      "required": [
        "adapter",
        "targets",
        "app_config"
      ],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "format": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "lint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "typecheck": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "build": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "security": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*(?![\\s\\S])"
          }
        }
      },
      "required": [
        "format",
        "lint",
        "typecheck",
        "test",
        "build",
        "security",
        "verify"
      ],
      "additionalProperties": false
    },
    "metro": {
      "type": "object",
      "properties": {
        "adapter": {
          "const": "metro-v1"
        },
        "mode": {
          "const": "development-client"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 28800
        }
      },
      "required": [
        "adapter",
        "mode",
        "ttl_seconds"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "profile",
        "contract_version",
        "config"
      ],
      "properties": {
        "adapter": {
          "const": "fastapi-postgres-v1"
        },
        "profile": {
          "const": "development"
        },
        "contract_version": {
          "const": 1,
          "type": "integer"
        },
        "config": {
          "const": ".gptclaw/backend.local.json"
        }
      }
    },
    "development_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "config"
      ],
      "properties": {
        "adapter": {
          "const": "eas-android-v1"
        },
        "config": {
          "const": ".gptclaw/development-build.json"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project",
    "mobile",
    "commands",
    "metro",
    "backend",
    "development_build"
  ],
  "additionalProperties": false
}
