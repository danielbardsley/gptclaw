#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

readonly BOOTSTRAP_VERSION="5"
readonly AWS_REGION=${jsonencode(aws_region)}
readonly DATA_VOLUME_ID=${jsonencode(data_volume_id)}
readonly INSTANCE_NAME=${jsonencode(instance_name)}
readonly LOG_GROUP_NAME=${jsonencode(log_group_name)}
readonly TAILSCALE_AUTH_SECRET_ARN=${jsonencode(tailscale_auth_secret_arn)}
readonly TAILSCALE_AUTH_KEY_VERSION=${jsonencode(tailscale_auth_key_version)}
readonly TAILSCALE_TAG=${jsonencode(tailscale_tag)}
readonly LOG_FILE="/var/log/gptclaw-bootstrap.log"

install -d -m 0750 /var/lib/gptclaw
touch "$LOG_FILE"
chmod 0640 "$LOG_FILE"
exec > >(tee -a "$LOG_FILE" | logger -t gptclaw-bootstrap) 2>&1

current_phase="initialization"

log() {
  printf '%s phase=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$current_phase" "$*"
}

on_error() {
  local exit_code=$?
  rm -f /var/lib/gptclaw/bootstrap-complete.json /var/lib/gptclaw/host-tools.json
  log "status=failed exit_code=$exit_code"
  exit "$exit_code"
}

trap on_error ERR

if [ "$(id -u)" -ne 0 ]; then
  log "status=failed reason=root-required"
  exit 1
fi

current_phase="host-tools-validation"
log "status=started"
# Invalidate before even checking the parser; a retry cannot retain stale success.
rm -f /var/lib/gptclaw/bootstrap-complete.json /var/lib/gptclaw/host-tools.json
command -v python3 >/dev/null
python3 /usr/local/libexec/gptclaw-host-tools begin
log "status=succeeded"

current_phase="base-packages"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools phase base-packages
systemctl enable --now rsyslog
log "status=succeeded"

current_phase="ssm-agent"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools phase ssm-agent
if [ "$(systemctl show --property=LoadState --value amazon-ssm-agent.service)" = loaded ]; then
  systemctl enable --now amazon-ssm-agent.service
else
  systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service
fi
log "status=succeeded"

current_phase="aws-cli"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools phase aws-cli
log "status=succeeded"

current_phase="forge-user"
log "status=started"
if ! id forge >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash forge
fi
passwd --lock forge >/dev/null
deluser forge sudo >/dev/null 2>&1 || true
install -d -o forge -g forge -m 0700 /home/forge/.ssh
install -o forge -g forge -m 0600 /etc/gptclaw/forge_authorized_key /home/forge/.ssh/authorized_keys
install -d -o forge -g forge -m 0755 /home/forge/.local/bin
cat >/etc/profile.d/gptclaw-forge-path.sh <<'PROFILE'
if [ "$USER" = "forge" ]; then
  PATH="$HOME/.local/bin:$PATH"
  export PATH
fi
PROFILE
chmod 0644 /etc/profile.d/gptclaw-forge-path.sh
chgrp forge /var/lib/gptclaw "$LOG_FILE"
chmod 0750 /var/lib/gptclaw
chmod 0640 "$LOG_FILE"
log "status=succeeded"

current_phase="project-volume"
log "status=started"
cat >/usr/local/sbin/gptclaw-mount-projects <<'MOUNT_SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail

readonly DATA_VOLUME_ID=${jsonencode(data_volume_id)}
readonly DEVICE_LINK="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$(printf '%s' "$DATA_VOLUME_ID" | tr -d '-')"

for _ in $(seq 1 120); do
  if [ -e "$DEVICE_LINK" ]; then
    break
  fi
  sleep 5
done

if [ ! -e "$DEVICE_LINK" ]; then
  echo "Persistent volume $DATA_VOLUME_ID was not found" >&2
  exit 1
fi

device=$(readlink -f "$DEVICE_LINK")
if [ -z "$device" ] || [ ! -b "$device" ]; then
  echo "Persistent volume link did not resolve to a block device" >&2
  exit 1
fi

if ! blkid "$device" >/dev/null 2>&1; then
  mkfs.ext4 -L FORGE_DATA "$device"
fi

filesystem_type=$(blkid -s TYPE -o value "$device")
if [ "$filesystem_type" != "ext4" ]; then
  echo "Persistent volume has unexpected filesystem type: $filesystem_type" >&2
  exit 1
fi

uuid=$(blkid -s UUID -o value "$device")
if [ -z "$uuid" ]; then
  echo "Persistent volume does not have a filesystem UUID" >&2
  exit 1
fi

install -d -m 0750 /srv/forge
if ! grep -Eq "^[[:space:]]*UUID=$uuid[[:space:]]+/srv/forge[[:space:]]" /etc/fstab; then
  printf 'UUID=%s /srv/forge ext4 defaults,nofail 0 2\n' "$uuid" >>/etc/fstab
fi
mountpoint -q /srv/forge || mount /srv/forge
install -d -o forge -g forge -m 0750 /srv/forge/projects
MOUNT_SCRIPT
chmod 0750 /usr/local/sbin/gptclaw-mount-projects
cat >/etc/systemd/system/gptclaw-projects-volume.service <<'UNIT'
[Unit]
Description=Mount the GptClaw persistent project volume
Wants=network-online.target
After=network-online.target
Before=gptclaw-bootstrap.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gptclaw-mount-projects
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now gptclaw-projects-volume.service
mountpoint -q /srv/forge
log "status=succeeded"

current_phase="tailscale"
log "status=started auth_key_version=$TAILSCALE_AUTH_KEY_VERSION"
python3 /usr/local/libexec/gptclaw-host-tools phase tailscale
systemctl enable --now tailscaled
if ! tailscale status --json | jq -e '.BackendState == "Running"' >/dev/null; then
  set +x
  tailscale_auth_key=$(aws secretsmanager get-secret-value \
    --region "$AWS_REGION" \
    --secret-id "$TAILSCALE_AUTH_SECRET_ARN" \
    --query SecretString \
    --output text)
  if [ -z "$tailscale_auth_key" ] || [ "$tailscale_auth_key" = "None" ]; then
    log "status=failed reason=empty-enrollment-secret"
    exit 1
  fi
  tailscale up \
    --auth-key="$tailscale_auth_key" \
    --hostname="$INSTANCE_NAME" \
    --advertise-tags="$TAILSCALE_TAG" \
    --ssh=false
  unset tailscale_auth_key
fi
tailscale status
log "status=succeeded"

current_phase="ssh-hardening"
log "status=started"
cat >/etc/ssh/sshd_config.d/60-gptclaw.conf <<'SSHD'
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
AllowUsers forge
X11Forwarding no
AllowTcpForwarding local
SSHD
install -d -m 0755 /run/sshd
sshd -t
systemctl reload-or-restart ssh.service
ufw default deny incoming
ufw default allow outgoing
ufw allow in on tailscale0 proto tcp to any port 22 comment 'GptClaw SSH over Tailscale'
ufw --force enable
log "status=succeeded"

current_phase="cloudwatch-agent"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools phase cloudwatch-agent
jq -n --arg group "$LOG_GROUP_NAME" '{
  agent: {run_as_user: "root"},
  logs: {
    logs_collected: {
      files: {
        collect_list: [
          {file_path: "/var/log/cloud-init-output.log", log_group_name: $group, log_stream_name: "{instance_id}/cloud-init"},
          {file_path: "/var/log/auth.log", log_group_name: $group, log_stream_name: "{instance_id}/auth"},
          {file_path: "/var/log/gptclaw-bootstrap.log", log_group_name: $group, log_stream_name: "{instance_id}/bootstrap"}
        ]
      }
    }
  }
}' >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
log "status=succeeded"

current_phase="host-policy"
log "status=started"
sudo -iu forge /usr/local/libexec/gptclaw-install-host-policy
log "status=succeeded"

current_phase="codex"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools phase codex
log "status=succeeded"

current_phase="completion"
log "status=started"
python3 /usr/local/libexec/gptclaw-host-tools finish
jq --arg bootstrap_version "$BOOTSTRAP_VERSION" '{
  bootstrap_version: $bootstrap_version,
  completed_at: .observed_at,
  status: "succeeded",
  profile_digest: .profile_digest,
  deployment_revision: .deployment_revision,
  components: (.components | map({key: .id, value: .version}) | from_entries)
}' /var/lib/gptclaw/host-tools.json >/var/lib/gptclaw/.bootstrap-complete.json.tmp
chmod 0644 /var/lib/gptclaw/.bootstrap-complete.json.tmp
mv /var/lib/gptclaw/.bootstrap-complete.json.tmp /var/lib/gptclaw/bootstrap-complete.json
log "status=succeeded"
