{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "releases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4,
      "type": "integer"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 48
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 48
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "const": "group"
          },
          "provider": {
            "const": "notes-postgres-v1"
          },
          "manifest_schema": {
            "const": 4
          },
          "catalogue_schema": {
            "const": 4
          },
          "stack": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "data": {
            "const": "persistent"
          },
          "exposure": {
            "const": "private"
          },
          "substitutions": {
            "const": [
              "project-id",
              "project-name",
              "base-path"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$",
                  "maxLength": 200
                },
                "output": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._/-]+$",
                  "maxLength": 200
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "maxLength": 64
                }
              },
              "required": [
                "source",
                "output",
                "sha256"
              ]
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "toolchains": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "web": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "schema_version": {
                    "type": "integer",
                    "const": 1
                  },
                  "profile": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "maxLength": 48
                  },
                  "profile_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "versions": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                        "maxLength": 32
                      },
                      "pnpm": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                        "maxLength": 32
                      }
                    },
                    "required": [
                      "node",
                      "pnpm"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "schema_version",
                  "profile",
                  "profile_version",
                  "versions"
                ],
                "additionalProperties": false
              },
              "api": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "schema_version": {
                    "type": "integer",
                    "const": 2
                  },
                  "profile": {
                    "const": "python-uv"
                  },
                  "profile_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "versions": {
                    "type": "object",
                    "properties": {
                      "python": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                        "maxLength": 32
                      },
                      "uv": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                        "maxLength": 32
                      }
                    },
                    "required": [
                      "python",
                      "uv"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "schema_version",
                  "profile",
                  "profile_version",
                  "versions"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "web",
              "api"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "description",
          "kind",
          "provider",
          "manifest_schema",
          "catalogue_schema",
          "stack",
          "data",
          "exposure",
          "substitutions",
          "files",
          "digest",
          "toolchains"
        ]
      }
    }
  }
}
