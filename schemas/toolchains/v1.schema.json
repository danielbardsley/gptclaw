{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "versions": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        },
        "pnpm": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        }
      },
      "required": [
        "node",
        "pnpm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile",
    "profile_version",
    "versions"
  ],
  "additionalProperties": false
}
