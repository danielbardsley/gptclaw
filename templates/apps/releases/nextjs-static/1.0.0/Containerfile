FROM docker.io/library/node@sha256:51b1100cc2a83d370c6a60952e3f2989c8a43159d0e38586e090f3b3326efefd
COPY checks/install-pnpm.cjs /tmp/install-pnpm.cjs
RUN node /tmp/install-pnpm.cjs && test "$(node --version)" = v24.21.0 && test "$(pnpm --version)" = 12.10.1
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG PROJECT_ID=local-static
ENV GPTCLAW_PROJECT_ID=$PROJECT_ID
RUN pnpm build && chown -R node:node /workspace
USER node
EXPOSE 3000
CMD ["node", "scripts/serve.mjs"]
