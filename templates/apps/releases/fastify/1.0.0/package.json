{
  "name": "gptclaw-fastify-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node scripts/preflight.ts",
    "format": "prettier --write src tests scripts eslint.config.js tsconfig.json package.json",
    "lint": "prettier --check src tests scripts eslint.config.js tsconfig.json package.json && eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-coverage --test-coverage-include=src/*.ts --test-coverage-exclude=src/server.ts --test-coverage-lines=80 --test-coverage-branches=80 --test tests/*.test.ts",
    "security": "pnpm audit --audit-level=high",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2"
  }
}
